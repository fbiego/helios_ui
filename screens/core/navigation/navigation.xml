<screen>
	<styles>
		<style
			name="style_base"
			layout="flex"
			flex_flow="column"
			flex_main_place="space_evenly"
			flex_track_place="center"
			flex_cross_place="center"
		/>
		<style name="style_pad" pad_ver="80" />
		<style name="style_pad_360" pad_ver="60" />
		<style name="style_pad_240" pad_ver="40" />
	</styles>
	<view extends="lv_obj">
		<style name="style_dark" />
		<style name="style_base" />
		<style name="style_pad" />
		<bind_style name="style_pad_360" subject="sb_screen_size" ref_value="1" />
		<bind_style name="style_pad_240" subject="sb_screen_size" ref_value="2" />

		<hs_text_normal text="Navigation" width="90%" style_text_align="center" />
		<hs_text_normal text="ESP32 Only" width="90%" style_text_align="center" />
		<wd_image
			src="icon_turn_left"
			scale_0="500"
			scale_1="385"
			scale_2="256"
			size_0="94"
			size_1="72"
			size_2="48"
			bind_scale="sb_screen_size"
			style_image_recolor="0xffffff"
			style_image_recolor_opa="255"
		/>
		<hs_text_normal text="Chronos" width="90%" style_text_align="center" />
		<hs_text_small text="Avaialble on Chronos v3.7.5+" width="90%" style_text_align="center" />
	</view>
</screen>

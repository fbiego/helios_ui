<screen>
	<styles>
		<style
			name="style_cont"
			width="466"
			height="466"
			align="center"
			border_width="0"
			pad_top="100"
			pad_bottom="150"
			pad_hor="33"
		/>
		<style name="style_cont_360" pad_hor="30" pad_top="80" pad_bottom="100" />
		<style name="style_cont_240" pad_hor="20" pad_row="5" pad_top="60" pad_bottom="80" />
		<style name="style_flex" layout="flex" flex_flow="row_wrap" pad_column="15" pad_row="10" />
		<style name="style_pad_grid" pad_hor="53" pad_row="15" />
		<style name="style_pad_grid_360" pad_hor="33" pad_row="10" pad_column="12" />
		<style name="style_pad_grid_240" pad_hor="20" pad_row="10" pad_column="10" />
	</styles>
	<view>
		<style name="style_dark" />

		<wd_list
			name="app_list"
			bind_mode="sb_app_list_mode"
			bind_circular="sb_list_circular_mode"
			bind_screen="sb_screen_size"
		>
			<wd_list-container>
				<bind_state_if_eq subject="sb_app_list_mode" state="user_1" ref_value="1" />
				<bind_style name="style_cont_360" subject="sb_screen_size" ref_value="1" />
				<bind_style name="style_cont_240" subject="sb_screen_size" ref_value="2" />
				<bind_style name="style_pad_grid" subject="sb_screen_size" ref_value="0" selector="user_1" />
				<bind_style name="style_pad_grid_360" subject="sb_screen_size" ref_value="1" selector="user_1" />
				<bind_style name="style_pad_grid_240" subject="sb_screen_size" ref_value="2" selector="user_1" />

				<app_item icon="icon_contacts" app_name="Contacts" />
				<app_item icon="icon_folder" app_name="Files" />
				<app_item icon="icon_running" app_name="Fitness" />
				<app_item icon="icon_measurement" app_name="Health" />
				<app_item icon="icon_music" app_name="Music" />
				<app_item icon="icon_navigation" app_name="Navigation" />
				<app_item icon="icon_chat" app_name="Notifications">
					<event_cb callback="on_notifications_clicked_cb" trigger="clicked" />
				</app_item>
				<app_item icon="icon_gear" app_name="Settings">
					<event_cb callback="on_settings_clicked_cb" trigger="clicked" />
				</app_item>
				<app_item icon="icon_sleep" app_name="Sleep" />
				<app_item icon="icon_stopwatch" app_name="Stopwatch" />
				<app_item icon="icon_timer" app_name="Timer" />
				<app_item icon="icon_weather" app_name="Weather">
					<event_cb callback="on_weather_clicked_cb" trigger="clicked" />
				</app_item>
			</wd_list-container>
		</wd_list>
	</view>
</screen>

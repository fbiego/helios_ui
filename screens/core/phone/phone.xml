<screen>
	<styles>
		<style
			name="style_cont"
			width="466"
			height="466"
			align="center"
			border_width="0"
			pad_top="100"
			pad_bottom="150"
			pad_hor="33"
		/>
		<style name="style_cont_360" pad_hor="30" pad_top="80" pad_bottom="100" />
		<style name="style_cont_240" pad_hor="20" pad_row="5" pad_top="60" pad_bottom="80" />
		<style name="style_flex" layout="flex" flex_flow="row_wrap" pad_column="15" pad_row="10" />
		<style name="style_pad_rect" pad_hor="18" />
		<style name="style_pad_rect_360" pad_hor="14" />
		<style name="style_pad_rect_240" pad_hor="10" />
		<style name="style_pad_none" />
	</styles>
	<view>
		<style name="style_dark" />

		<wd_list name="main_about_list" bind_screen="sb_screen_size">
			<wd_list-title height="content">
				<hs_card width="content" align="center" clickable="false" style_max_width="100%">
					<hs_text_normal text="Phone Link" />
				</hs_card>
			</wd_list-title>
			<wd_list-container>
				<bind_style name="style_cont_360" subject="sb_screen_size" ref_value="1" />
				<bind_style name="style_cont_240" subject="sb_screen_size" ref_value="2" />
				<bind_state_if_eq subject="sb_screen_type" ref_value="1" state="user_1" />
				<bind_style name="style_pad_rect" subject="sb_screen_size" ref_value="0" selector="user_1" />
				<bind_style name="style_pad_rect_360" subject="sb_screen_size" ref_value="1" selector="user_1" />
				<bind_style name="style_pad_rect_240" subject="sb_screen_size" ref_value="2" selector="user_1" />

				<hs_card>
					<hs_info label="Status" info="Connected" />
				</hs_card>

				<hs_card>
					<hs_info label="Last Sync" info="2d 4h" />
				</hs_card>

				<hs_card>
					<hs_info label="Google" info="Pixel 7" />
					<hs_line />
					<hs_info label="SDK" info="37" />
					<hs_line />
					<hs_bar tag="battery" bind_value="sb_battery_percent" />
					<hs_info label="Charging" info="Yes" />
				</hs_card>
				<hs_card>
					<hs_info label="Chronos" info="App" />
					<hs_line />
					<hs_info_sb label="Version" info="sb_chronos_app_version" />
					<hs_info label="Code" info="52" />
				</hs_card>
				<hs_card>
					<hs_button checkable="true" tag="Find Phone" style_bg_color="#color_button_primary" />
				</hs_card>
				<hs_space />
			</wd_list-container>
		</wd_list>
	</view>
</screen>

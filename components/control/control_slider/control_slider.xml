	<api>
		<prop name="icon_left" type="image" default="icon_volume_high" />
		<prop name="icon_right" type="image" default="icon_empty" />
	</api>
	<view extends="lv_slider" scrollable="false" event_bubble="true" scroll_on_focus="false">
		<remove_style_all />
		<style name="style_slider" />
		<style name="style_indicator" selector="indicator" />
		<bind_style name="style_slider_360" subject="sb_screen_size" ref_value="1" />
		<bind_style name="style_slider_240" subject="sb_screen_size" ref_value="2" />

		<wd_image
			clickable="false"
			align="left_mid"
			src="$icon_left"
			scale_0="256"
			scale_1="190"
			scale_2="130"
			size_1="60"
			size_2="40"
			x_0="24"
			x_1="14"
			x_2="8"
			bind_scale="sb_screen_size"
			style_blend_mode="difference"
		/>

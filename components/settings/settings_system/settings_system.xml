<component>
	<previews>
		<preview width="466" height="466" style_radius="233" style_bg_color="0x000" />
		<preview width="360" height="360" style_radius="180" style_bg_color="0x000" />
		<preview width="240" height="240" style_radius="120" style_bg_color="0x000" />
	</previews>

	<api>
		<!-- Add your API here here. For example 
		<prop name="prop1" type="int" default="0" help="What is this property?"/>
		-->
	</api>

	<styles>
		<style name="style_base" pad_row="10" pad_ver="120" />
		<style name="style_pad_360" pad_ver="90" pad_hor="25" />
		<style name="style_pad_240" pad_ver="60" pad_hor="20" />
	</styles>

	<view extends="wd_list" bind_screen="sb_screen_size">
		<wd_list-container>
			<style name="style_base" />
			<bind_style name="style_pad_360" subject="sb_screen_size" ref_value="1" />
			<bind_style name="style_pad_240" subject="sb_screen_size" ref_value="2" />

			<hs_card>
				<hs_switch tag="circular_scroll" bind_value="sb_list_circular_mode" />
				<hs_line />
				<hs_switch tag="grid_mode" bind_value="sb_app_list_mode" />
				<hs_line />
				<hs_dropdown
					tag="language"
					options="English&#10;Portuguese&#10;German&#10;Spanish&#10;French&#10;Hungarian&#10;Russian&#10;Greek&#10;Thai&#10;Chinese&#10;Japanese&#10;Hindi"
					bind_value="sb_language"
				/>
			</hs_card>

			<hs_card>
				<hs_button tag="reboot" style_bg_color="#color_button_primary" />
				<hs_button tag="shutdown" style_bg_color="#color_button_primary" />
			</hs_card>
			<hs_card>
				<hs_button tag="factory_reset" text_color="#color_danger" style_bg_color="#color_button_danger" />
			</hs_card>
		</wd_list-container>
	</view>
</component>

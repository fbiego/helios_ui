# lv_conf_emscripten.defaults
#
# LVGL configuration for the Emscripten/SDL2 browser build.

LV_USE_SDL              1
LV_USE_WINDOWS          0

LV_COLOR_DEPTH          32

LV_USE_STDLIB_MALLOC    LV_STDLIB_CLIB
LV_USE_STDLIB_STRING    LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF   LV_STDLIB_CLIB

LV_USE_LOG              1
LV_LOG_LEVEL            LV_LOG_LEVEL_WARN
LV_LOG_PRINTF           1

LV_USE_FS_STDIO         0
LV_USE_LODEPNG          1
LV_USE_TINY_TTF         1
LV_TINY_TTF_FILE_SUPPORT 0

LV_USE_QRCODE           1

LV_FONT_MONTSERRAT_14   1
LV_FONT_MONTSERRAT_16   1
LV_FONT_MONTSERRAT_24   1

LV_USE_PERF_MONITOR     1
LV_USE_OBJ_NAME         1
LV_USE_TRANSLATION      1

LV_USE_PERF_MONITOR     0
LV_USE_SYSMON           1
LV_USE_MEM_MONITOR      1

LV_USE_FLOAT    1

LV_USE_STDLIB_MALLOC    LV_STDLIB_BUILTIN
LV_MEM_SIZE             (512 * 1024U)
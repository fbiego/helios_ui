<globals>
	<api>
		<!-- Add <enumdefs> here -->
		<enumdef name="screen_size">
			<enum name="sc_466" value="0" />
			<enum name="sc_360" value="1" />
			<enum name="sc_240" value="2" />
		</enumdef>
	</api>

	<consts>
		<!-- Add <px>, <int>, <color> etc here -->
		<color name="color_primary" value="0x0534ff" />
	</consts>

	<styles>
		<!-- Add <style> tags here -->
		<style name="style_dark" bg_color="0x000000" text_color="0xffffff" />

		<style name="style_primary_bg" bg_color="#color_primary" />
		<style name="style_white_bg" bg_color="0xffffff" />

		<style name="style_icon_recolor" />

		<style name="style_text_small_466" text_font="NS_Medium_20" />
		<style name="style_text_small_360" text_font="NS_Medium_18" />
		<style name="style_text_small_240" text_font="NS_Medium_14" />

		<style name="style_text_normal_466" text_font="NS_Medium_40" />
		<style name="style_text_normal_360" text_font="NS_Medium_30" />
		<style name="style_text_normal_240" text_font="NS_Medium_20" />

		<style name="style_text_large_466" text_font="NS_Medium_140" />
		<style name="style_text_large_360" text_font="NS_Medium_100" />
		<style name="style_text_large_240" text_font="NS_Medium_70" />
	</styles>

	<subjects>
		<!-- Add <int>, <string>, or <float> subjects here -->

		<int name="sb_screen_size" value="0" />
		<int name="sb_screen_type" value="0" />

		<int name="sb_app_list_mode" value="0" min_value="0" max_value="1" />
		<int name="sb_list_circular_mode" value="1" min_value="0" max_value="1" />
		<int name="sb_screen_brightness" value="80" min_value="1" max_value="100" />
		<int name="sb_screen_rotation" value="0" min_value="0" max_value="3" />
		<int name="sb_screen_timeout" value="0" min_value="0" max_value="4" />
		<int name="sb_screen_rtw" value="1" min_value="0" max_value="1" />

		<int name="sb_battery_percent" value="70" min_value="0" max_value="100" />
		<int name="sb_sound_volume" value="40" min_value="0" max_value="100" />
		<int name="sb_focusable" value="1" min_value="0" max_value="1" />
	</subjects>

	<images>
